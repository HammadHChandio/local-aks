# Copy to sas-viya/order.env (git-ignored). Values come from your SAS order; never commit them.
SAS_ORDER_NUMBER=
SAS_CADENCE_NAME=stable            # stable | lts
SAS_CADENCE_VERSION=               # e.g. 2026.10  (quoted in ansible vars automatically)
SAS_INGRESS_FQDN=viya.local.test   # resolves to the emulated AKS node locally
SAS_NAMESPACE=viya
