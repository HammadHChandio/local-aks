# Local (Floci AZ) identities. The all-zero prefix is reserved for fixtures: scripts/lib.sh
# refuses to run in local mode with any other subscription id, so a real id cannot slip in.
TENANT_ID=00000000-0000-0000-0000-000000000002
HUB_SUBSCRIPTION_ID=00000000-0000-0000-0000-00000000a001
SPOKE_SUBSCRIPTION_ID=00000000-0000-0000-0000-00000000b001
# Floci's default subscription: nothing may ever be created here (asserted by tests).
TRAP_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000001
# Terraform reaches Floci through the compat shim (HTTPS). Direct Floci (cert download, ARM probes):
FLOCI_METADATA_HOST=localhost:4578
FLOCI_DIRECT=localhost:4577
# Floci's seeded dev application (not a secret; Floci does not validate it by default).
FLOCI_CLIENT_ID=11111111-1111-1111-1111-111111111111
